# Copy to .env. Keys stay on the server. Test keys only in this build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM=
# Verified Resend sending address, e.g. Invoingo <invoices@your-domain.com>
PUBLIC_BASE_URL=http://127.0.0.1:4185
# At least 32 random characters. Enter this operator token in Connections.
INVOINGO_ADMIN_TOKEN=

OPENAI_API_KEY=
MIOBOT_AI_MODEL=
MIOBOT_AI_ENABLED=false
MIOBOT_TIMEZONE=America/New_York
# MioBot AI: choose a Responses API model available to your account.
# Set MIOBOT_AI_ENABLED=true only after adding OPENAI_API_KEY and MIOBOT_AI_MODEL.

# Public store listing URLs. Leave blank until listings exist.
APP_STORE_URL=
GOOGLE_PLAY_URL=

# Automatic payment receipts: owner business email + customer by default.
AUTO_SEND_RECEIPTS=true
# Optional fallback if the business profile has no owner email.
RECEIPT_OWNER_EMAIL=

# Stripe-hosted bank setup; enable after activating Connect on your Stripe test platform
STRIPE_CONNECT_ENABLED=false
# Supabase cloud deployment preparation (not connected until deployment is completed)
# Public project URL and publishable key can be used by the frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never include this in frontend or EXPO_PUBLIC variables.
SUPABASE_SECRET_KEY=
# HTTPS website origin for deployed Edge Functions; do not use localhost here.
APP_URL=https://invoingo.com

